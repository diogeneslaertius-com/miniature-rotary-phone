# Серверный ключ — для Geocoder/Directions API (держите в секрете, не светите на фронте)
DGIS_API_KEY=your_server_side_key

# Клиентский ключ — для рендера карты через MapGL JS API (домен-ограниченный, можно отдавать на фронт)
DGIS_MAP_KEY=your_map_client_key

# ID стиля, полученный в Редакторе стилей 2ГИС (Platform Manager -> Стили карты)
MAP_STYLE_ID=00000000-0000-0000-0000-000000000000

# Включает режим репетиции/демо (см. README, TODO: подключить кэш-слой)
DEMO_MODE=false

# Город и центр карты по умолчанию — единственное место, которое нужно
# поменять, чтобы переключиться с Алматы на другой город (см. README).
DEFAULT_CITY=Алматы
DEFAULT_LAT=43.2380
DEFAULT_LON=76.9286

# Опционально: если задан — /api/voice сначала пробует Groq (быстрее,
# облачный), при сбое/таймауте автоматически откатывается на локальный
# faster-whisper. Без ключа работает только локальный путь.
GROQ_API_KEY=

# ID региона 2ГИС для вашего города — жёстко ограничивает Suggest этим
# регионом, иначе он может подмешивать результаты из других регионов/
# стран. Получите один раз вручную (не выдумывайте число):
#   https://catalog.api.2gis.com/2.0/region/search?q=Караганда&key=ВАШ_КЛЮЧ
# и возьмите result.items[0].id из ответа.
DGIS_REGION_ID=
